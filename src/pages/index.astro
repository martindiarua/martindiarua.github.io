---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import SignalLine from "../components/SignalLine.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import { projects } from "../data/projects";

const featuredProjects = projects.filter(project => project.featured);

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">

  <div class="eyebrow mb-2">// martin diarua — data scientist</div>

  <div class="text-3xl md:text-4xl font-display font-semibold leading-tight">
    Delivering Intelligence Services and Tools to Businesses.
  </div>

  <div class="text-xl py-3 font-mono text-secondary">
    Data Science Practitioner · Machine Learning Enthusiast
  </div>

  <div class="py-2">
    <p class="text-lg">
      I build intelligent products powered by data.

      My work combines data science, machine learning, Python, and software engineering to solve real-world problems. From predictive models to business-focused applications, I enjoy turning ideas into practical, scalable solutions.
    </p>
  </div>

  <div class="mt-8">
    <a class="btn" href="/projects">
      View Projects
    </a>

    <a href="/cv" class="btn btn-outline ml-5">
      View Resume
    </a>
  </div>

  <div class="mt-16">
    <div class="text-3xl font-display font-semibold mb-5">
      Featured Work
    </div>

    {
      featuredProjects.map((project, i) => (
        <>
          <HorizontalCard
            title={project.title}
            img={project.image}
            desc={project.description}
            url={project.github}
            badge={project.badge}
          />
          <SignalLine seed={i + 1} />
        </>
      ))
    }

    <div class="mt-6">
      <a href="/projects" class="btn btn-outline">
        View All Projects →
      </a>
    </div>

  </div>

  <div class="mt-16">
    <div class="text-3xl font-display font-semibold mb-5">
      Latest Articles
    </div>

    {
      last_posts.map((post, i) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={post.data.badge}
          />
          <SignalLine seed={i + 10} />
        </>
      ))
    }

  </div>

</BaseLayout>