---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import SignalLine from "../components/SignalLine.astro";
import { projects } from "../data/projects";

const categories = [
  "Machine Learning",
  "Python Development",
  "Data Analytics",
  "Quality Assurance",
];
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">

  <div class="eyebrow mb-2">// selected work</div>

  <div class="text-4xl font-display font-semibold mb-3">
    Projects
  </div>

  <p class="text-lg mb-10 max-w-[65ch]">
    A curated collection of projects demonstrating my experience in machine learning,
    data analytics, Python development, automation, quality assurance, and business intelligence.
  </p>

  {
    categories.map((category, ci) => (
      <>
        <div class="eyebrow mt-10 mb-4">{category}</div>

        {
          projects
            .filter(project => project.category === category)
            .map((project, i) => (
              <>
                <HorizontalCard
                  title={project.title}
                  img={project.image}
                  desc={project.description}
                  url={project.github}
                  badge={project.badge}
                />
                <SignalLine seed={ci * 10 + i + 1} />
              </>
            ))
        }

      </>
    ))
  }

</BaseLayout>